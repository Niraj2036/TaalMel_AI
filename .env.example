# ─── OpenRouter (LLM) ────────────────────────────────────────────────────────
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# ─── Database (Neon / Supabase / any PostgreSQL) ─────────────────────────────
# Pooled connection (used by Prisma at runtime via connection pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require&pgbouncer=true"

# Direct connection (used by Prisma migrations / db push — bypasses pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# ─── Reconciliation Engine Config ────────────────────────────────────────────
TOLERANCE_MINOR_UNITS=1
MAX_DATE_LAG_DAYS=3
MAX_SLA_HOURS=48

# ─── Feature Flags ───────────────────────────────────────────────────────────
ENABLE_AGENT=true
